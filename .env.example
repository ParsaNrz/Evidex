# Copy to .env in the directory where you run `evidex`; it is loaded automatically.
# Variables already exported in your shell take precedence. Never commit an actual API key.
# EVIDEX_DEMO=1 (or `evidex serve --demo`) forces synthetic fixtures and ignores the key.
# For local HTTP (no HTTPS proxy) set EVIDEX_SECURE_COOKIES=0 or pass --insecure-cookies.
EVIDEX_DATA_DIR=.evidex
EVIDEX_DEMO=0
EVIDEX_LLM_API_KEY=
EVIDEX_LLM_MODEL=gpt-4o-mini
EVIDEX_LLM_BASE_URL=https://api.openai.com/v1
EVIDEX_CROSSREF_MAILTO=
EVIDEX_SECURE_COOKIES=1
EVIDEX_REGISTRATION=1
# EVIDEX_PDF_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf  # unset: auto-detect a Unicode TTF
