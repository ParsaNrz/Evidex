# Reference only: export variables in your shell or use uvicorn --env-file .env.
# Never commit an actual API key.
EVIDEX_DATA_DIR=.evidex
EVIDEX_DEMO=0
EVIDEX_LLM_API_KEY=
EVIDEX_LLM_MODEL=gpt-4o-mini
EVIDEX_LLM_BASE_URL=https://api.openai.com/v1
EVIDEX_CROSSREF_MAILTO=
EVIDEX_SECURE_COOKIES=1
EVIDEX_REGISTRATION=1
# EVIDEX_PDF_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf  # unset: auto-detect a Unicode TTF
